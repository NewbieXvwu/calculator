gcd(x^2+1,x-1);
quo(x^3-1,x-1);
rem(x^3-1,x-1);
quo(x^4+1,x^2+1);
rem(x^4+1,x^2+1);
partfrac(1/(x^2-1));
partfrac(x/(x^2-3*x+2));
partfrac(1/((x-1)^2*(x+2)));
partfrac((x^2+1)/((x-1)*(x+2)*(x-3)));
