// ============ SECTION 1: App 组合查询 (10 个 f) ============;
all_trig_solutions:=1;
f1:=x^4-5*x^3+2*x-1;
normal(diff(f1,x));
solve(f1=0,x);
solve(diff(f1,x)=0,x);
solve(denom(normal(f1))=0,x);
limit(f1,x,+inf);
limit(f1,x,-inf);
limit(f1,x,2,1);
limit(f1,x,2,-1);
normal(subst(f1,x=-x));
period(f1,x);
domain(f1,x);
evalf(subst(f1,x=2));
sign(subst(diff(f1,x),x=2));
extrema(f1,x);
;
f2:=(x^2-1)/(x^2+1);
normal(diff(f2,x));
solve(f2=0,x);
